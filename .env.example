# ── Database ─────────────────────────────────────────────
# Password Postgres, bikin acak: openssl rand -base64 24
POSTGRES_PASSWORD=ganti-dengan-password-acak

# ── Branding ─────────────────────────────────────────────
# Nama yang muncul di logo, judul halaman, dan header PDF
BRAND_NAME=Haus Kayu
# Nama usaha / badan usaha (bisa diubah lagi di menu Pengaturan)
BUSINESS_NAME=PT Contoh Usaha Sejahtera
# Akun kas & bank awal, pisahkan dengan koma (cuma dipakai saat database masih kosong)
SEED_ACCOUNTS=Kas Tunai,Rekening Bank,Payment Gateway

# ── Owner pertama ────────────────────────────────────────
# Cuma dipakai SEKALI saat belum ada user. Setelah login pertama,
# ganti password di "Akun Saya" lalu hapus ADMIN_PASSWORD dari file ini.
ADMIN_EMAIL=owner@example.com
ADMIN_NAME=Owner
ADMIN_PASSWORD=minimal-10-karakter

# ── Image Docker (opsional) ──────────────────────────────
# Default pakai image siap pakai dari GitHub Container Registry.
# APP_IMAGE=ghcr.io/haustex/pembukuan-umkm:latest
